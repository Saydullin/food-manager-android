<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        *Local builds only (debugLocal/releaseLocal): the backend runs over plain HTTP on a
        developer machine whose LAN IP differs per person (local.properties -> localApi.host),
        so cleartext is allowed for any host instead of listing addresses. Overrides
        src/main/res/xml/network_security_config.xml for these build types only.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
